# ─── Deriv API ────────────────────────────────────────────────────────────────
# Token gerado em: Deriv API Dashboard > Select authorisation scope > Trade + Account management
DERIV_TOKEN=
# App ID — registar em https://api.deriv.com/app-registration ou usar 1089 para testes
DERIV_APP_ID=1089

# ─── Instrumento ──────────────────────────────────────────────────────────────
# frxXAUUSD = Ouro (Gold) | R_100 = Volatility 100 (para testes)
SYMBOL=frxXAUUSD
# M1 | M5 | M15 | M30 | H1 | H4 | D1
TIMEFRAME=M15

# ─── Multiplier (produto Deriv) ────────────────────────────────────────────────
# Multiplicador: 10 | 20 | 50 | 100 | 200 | 500 (depende do instrumento)
MULTIPLIER=100
# Stake por trade em USD (capital por posição)
STAKE=10

# ─── Capital e Risco ──────────────────────────────────────────────────────────
CAPITAL_TOTAL=10000
RISK_PERC=1
DAILY_LOSS_PERC=5

# ─── Estratégia SMA 20 ────────────────────────────────────────────────────────
SMA_PERIOD=20
SLOPE_THRESHOLD=0.5
SL_POINTS=2.0
TRAILING_BUFFER=0.5
TP1_RATIO=2.0
TP1_CLOSE_PERC=80

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
PORT=8000

# ─── Alertas ──────────────────────────────────────────────────────────────────
WEBHOOK_URL=
