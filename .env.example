# ══════════════════════════════════════════════════════════════════════════════
#  Multi Trader Pro — Apenas credenciais e infraestrutura ficam aqui.
#
#  ⚙ TODA a configuração de trading (símbolo, timeframe, stake, risco,
#    estratégia, trailing, alertas) é feita VISUALMENTE pelo painel web
#    no botão "⚙ Config" — e fica salva em config.json automaticamente.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Deriv API (obrigatório) ──────────────────────────────────────────────────
# PAT Token: Deriv API Dashboard > Create API Token > selecionar Trade + Account
DERIV_TOKEN=

# App ID do app nativo criado em https://api.deriv.com/app-registration
DERIV_APP_ID=

# ID da conta Options: obter via GET https://api.derivws.com/trading/v1/options/accounts
DERIV_ACCOUNT_ID=

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
PORT=8001
