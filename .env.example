# ─── Capital.com API ──────────────────────────────────────────────────────────
# Gerar em: Settings > API integrations > Generate new key
CAPITAL_API_KEY=
# Email da conta Capital.com
CAPITAL_EMAIL=
# Senha personalizada criada ao gerar a API key (não a senha da conta)
CAPITAL_PASS=

# true = demo (demo-api-capital.backend-capital.com)
# false = live (api-capital.backend-capital.com)
CAPITAL_USE_DEMO=true

# ─── Instrumento e Timeframe ──────────────────────────────────────────────────
# Epic do instrumento na Capital.com (busca em: GET /markets?searchTerm=gold)
EPIC=GOLD
# M1 | M5 | M15 | M30 | H1 | H4 | D1 | W1
TIMEFRAME=M15

# ─── Capital e Risco ──────────────────────────────────────────────────────────
CAPITAL_TOTAL=10000
# % do equity arriscado por trade
RISK_PERC=1
# % máximo de perda no dia antes de parar entradas
DAILY_LOSS_PERC=5

# Fator de ajuste do tamanho (1.0 = 1 unit = 1 oz no Gold)
# Ajuste se a P&L por unidade for diferente do esperado
SIZE_FACTOR=1.0
# Tamanho mínimo permitido pela plataforma
MIN_SIZE=0.1

# ─── Estratégia: SMA 20 Trend Following ───────────────────────────────────────
SMA_PERIOD=20
# Diferença mínima entre SMA[0] e SMA[3] para confirmar tendência
SLOPE_THRESHOLD=0.5
# Stop Loss: pontos abaixo/acima do pivot
SL_POINTS=2.0
# Buffer do Trailing Stop
TRAILING_BUFFER=0.5

# ─── Gestão de TP ─────────────────────────────────────────────────────────────
TP1_RATIO=2.0
# % da posição a fechar no TP1
TP1_CLOSE_PERC=80

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
PORT=8000

# ─── Alertas ──────────────────────────────────────────────────────────────────
WEBHOOK_URL=
