# ══════════════════════════════════════════════════════════════════════════════
#  Multi Trader Pro — .env.example
#
#  ⚙ TODA a configuração de trading (símbolo, timeframe, stake, risco,
#    estratégia, trailing, alertas) é feita VISUALMENTE pelo painel web
#    no botão "⚙ Config" — e fica salva em config/config.json automaticamente.
#
#  As chaves de API também podem ser configuradas pelo painel em
#  config/keys.json — mais seguro que deixar no .env em produção.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
PORT=8000

# ─── Modo de Operação ─────────────────────────────────────────────────────────
# true  = paper trading (simula trades sem abrir contratos reais)
# false = trading real (requer credenciais Deriv abaixo)
PAPER_TRADING=true

# ─── Deriv API (obrigatório apenas com PAPER_TRADING=false) ───────────────────
# PAT Token: Deriv API Dashboard > Create API Token > selecionar Trade + Account
DERIV_TOKEN=

# App ID do app nativo criado em https://api.deriv.com/app-registration
DERIV_APP_ID=

# ID da conta Options: obter via GET https://api.derivws.com/trading/v1/options/accounts
DERIV_ACCOUNT_ID=
