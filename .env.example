# ─── OANDA ────────────────────────────────────────────────────────────────────
# Gere o token em: https://www.oanda.com/account/tpa/personal_token
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# true = practice (api-fxpractice.oanda.com)
# false = live    (api-fxtrade.oanda.com)
OANDA_USE_PRACTICE=true

# ─── Instrumento e Timeframe ──────────────────────────────────────────────────
# Formato OANDA: XAU_USD, EUR_USD, GBP_USD etc.
INSTRUMENT=XAU_USD
TIMEFRAME=M15

# ─── Capital e Risco ──────────────────────────────────────────────────────────
CAPITAL_TOTAL=10000
# % do equity arriscado por trade
RISK_PERC=1
# % máximo de perda no dia antes de parar entradas
DAILY_LOSS_PERC=5

# ─── Estratégia: SMA 20 Trend Following ───────────────────────────────────────
# Período da Média Móvel Simples
SMA_PERIOD=20

# Diferença mínima entre SMA[0] e SMA[3] para confirmar tendência
# Para XAU/USD: ~0.5 a 1.0 (em USD)
SLOPE_THRESHOLD=0.5

# Stop Loss: pontos abaixo da mínima/máxima do pivot
# Para XAU/USD: ~1.5 a 3.0 (em USD por onça)
SL_POINTS=2.0

# Buffer do Trailing Stop (pontos além do low/high anterior)
TRAILING_BUFFER=0.5

# ─── Gestão de TP ─────────────────────────────────────────────────────────────
# Razão do TP1 em relação ao SL (ex: 2.0 = 2:1 R/R)
TP1_RATIO=2.0
# % da posição a fechar no TP1
TP1_CLOSE_PERC=80

# ─── Servidor HTTP ────────────────────────────────────────────────────────────
PORT=8000

# ─── Alertas ──────────────────────────────────────────────────────────────────
# Webhook Discord: https://discord.com/api/webhooks/...
# Webhook Telegram: via bot intermediário
WEBHOOK_URL=
